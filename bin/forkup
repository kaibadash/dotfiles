#!/bin/bash
set -euo pipefail

die() {
  echo "forkup: $*" >&2
  exit 1
}

require_git_repo() {
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "not a git repository"
}

require_idle_worktree() {
  local rebase_merge rebase_apply merge_head cherry_head
  rebase_merge="$(git rev-parse --git-path rebase-merge)"
  rebase_apply="$(git rev-parse --git-path rebase-apply)"
  merge_head="$(git rev-parse --git-path MERGE_HEAD)"
  cherry_head="$(git rev-parse --git-path CHERRY_PICK_HEAD)"
  if [[ -d "$rebase_merge" || -d "$rebase_apply" ]]; then
    die "rebase in progress"
  fi
  if [[ -f "$merge_head" ]]; then
    die "merge in progress"
  fi
  if [[ -f "$cherry_head" ]]; then
    die "cherry-pick in progress"
  fi
  if [[ -n "$(git status --porcelain)" ]]; then
    die "working tree is dirty"
  fi
}

resolve_parent_nwo() {
  local info is_fork nwo
  command -v gh >/dev/null 2>&1 || die "gh is required"
  info="$(gh repo view --json isFork,parent --jq '[.isFork, (.parent.owner.login + "/" + .parent.name)] | @tsv')" || die "gh repo view failed"
  is_fork="${info%%$'\t'*}"
  nwo="${info#*$'\t'}"
  if [[ "$is_fork" != "true" || -z "$nwo" || "$nwo" == "/" ]]; then
    die "not a fork"
  fi
  printf '%s\n' "$nwo"
}

ensure_upstream() {
  local nwo url
  nwo="$(resolve_parent_nwo)" || exit 1
  if git remote get-url upstream >/dev/null 2>&1; then
    printf '%s\n' "$nwo"
    return 0
  fi
  url="$(gh repo view "$nwo" --json url --jq .url)" || die "gh repo view failed"
  if [[ -z "$url" || "$url" == "null" ]]; then
    die "gh repo view failed"
  fi
  git remote add upstream "$url"
  printf '%s\n' "$nwo"
}

default_branch_of() {
  local nwo="$1"
  local branch
  branch="$(gh repo view "$nwo" --json defaultBranchRef --jq .defaultBranchRef.name)" || die "failed to resolve default branch"
  if [[ -z "$branch" || "$branch" == "null" ]]; then
    die "failed to resolve default branch"
  fi
  printf '%s\n' "$branch"
}

switch_to_branch() {
  local branch="$1"
  if git show-ref --verify --quiet "refs/heads/$branch"; then
    git switch "$branch"
  elif git show-ref --verify --quiet "refs/remotes/origin/$branch"; then
    git switch -c "$branch" --track "origin/$branch"
  else
    git switch -c "$branch" --track "upstream/$branch"
  fi
}

push_branch() {
  local branch="$1"
  if git show-ref --verify --quiet "refs/remotes/origin/$branch"; then
    git push --force-with-lease origin "$branch" || die "origin has new commits; force-with-lease refused"
  else
    git push -u origin "$branch" || die "failed to push origin"
  fi
}

main() {
  local nwo branch
  if [[ "$#" -ne 0 ]]; then
    die "no arguments"
  fi
  require_git_repo
  require_idle_worktree
  nwo="$(ensure_upstream)" || exit 1
  git fetch upstream --prune || die "failed to fetch upstream"
  git fetch origin || die "failed to fetch origin"
  branch="$(default_branch_of "$nwo")" || exit 1
  switch_to_branch "$branch"
  if ! git rebase "upstream/$branch"; then
    echo "forkup: rebase conflict; run git rebase --continue or git rebase --abort" >&2
    exit 1
  fi
  push_branch "$branch"
}

main "$@"
